<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Punnayee Construction</title>
    <link rel="icon" href="/Images/logo.png" type="image/png">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div id="loader-wrapper">
        <div class="loader"></div>
    </div>
    <!-- Navbar -->
    <%- include("../includes/navbar.ejs") %>
   
    
    <!-- Main Content -->
    <div class="container">
        <%- body %>
    </div>
    <a href="https://wa.me/+919764609727" target="_blank" class="whatsapp-button hidden" title="Chat with Kishor Padul">
        <i class="fab fa-whatsapp"></i>
    </a>
    
    <!-- Footer -->
    <%- include("../includes/footer.ejs") %>

     <!-- WhatsApp Button -->
     
    <!-- Scripts -->
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const loaderWrapper = document.getElementById("loader-wrapper");
            loaderWrapper.classList.add("hidden");
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const whatsappButton = document.querySelector(".whatsapp-button");
    
            function togglePopup() {
                whatsappButton.classList.toggle("hidden");
    
                // Add popup animation when it becomes visible
                if (!whatsappButton.classList.contains("hidden")) {
                    whatsappButton.style.animation = "popup 0.6s ease-out, bell-shake 2s infinite ease-in-out";
                }
            }
    
            // Trigger the popup every 5 seconds
            setInterval(() => {
                togglePopup();
            }, 5000); // Every 5 seconds
        });
    </script>
    





    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>

</body>
</html>
