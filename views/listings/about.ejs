<% layout('/layouts/boilerplate') -%>
<body>
    <!-- Header Section -->
    <header class="bg-primary-custom text-center py-5">
        <h1><strong>Punnayee Construction</strong></h1>
        <p>Your Trusted Partner in Construction Excellence</p>
    </header>

    <!-- About Section -->
    <section class="container my-5">
        <h2 class="section-title text-secondary-custom">About Us</h2>
        <p>
            Punnayee Construction is a leading construction company committed to delivering exceptional quality and innovative building solutions. With years of experience and a passion for excellence, we specialize in residential, commercial, and industrial projects, ensuring customer satisfaction every step of the way.
        </p>
    </section>

    <!-- Image Gallery Section -->
    <section class="container my-5">
        <h2 class="section-title text-secondary-custom">Our Work in Action</h2>
        <div class="row">
            <div class="col-md-4">
                <div class="image-container">
                    <img src="/Images/cons.jpg" alt="Construction Site" class="hover-effect">
                    <p class="image-caption">A glimpse of our latest construction site in progress.</p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="image-container">
                    <img src="/Images/team.jpg" alt="Our Team" class="hover-effect">
                    <p class="image-caption">Meet our dedicated and skilled construction team.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="image-container">
                    <img src="/Images/slope slap.jpg" alt="Slope Slab Construction" class="hover-effect">
                    <p class="image-caption">Expertly designed slope slab ensuring durability.</p>
                </div>
            </div>
        </div>
    </section>
     <!-- Why Choose Us Section -->
     <section class="container my-5">
        <h2 class="section-title text-secondary-custom">Why Choose Us?</h2>
        <div class="row text-center">
            <div class="col-md-4 animate-card">
                <i class="fas fa-check-circle icon-large text-success"></i>
                <h5><strong>Quality Checks</strong></h5>
                <p>We follow rigorous quality control measures to ensure top-notch construction.</p>
            </div>
            <div class="col-md-4 animate-card">
                <i class="fas fa-cubes icon-large text-primary"></i>
                <h5><strong>Branded Material</strong></h5>
                <p>Only the best materials from reputed brands are used in our projects.</p>
            </div>
            <div class="col-md-4 animate-card">
                <i class="fas fa-user-tie icon-large text-warning"></i>
                <h5><strong>No Third Party</strong></h5>
                <p>We manage projects in-house, ensuring accountability and reliability.</p>
            </div>
            <div class="col-md-4 animate-card">
                <i class="fas fa-hard-hat icon-large text-danger"></i>
                <h5><strong>Dedicated Engineer</strong></h5>
                <p>Each project is assigned a dedicated engineer for smooth execution.</p>
            </div>
            <div class="col-md-4 animate-card">
                <i class="fas fa-tags icon-large text-info"></i>
                <h5><strong>Best Price</strong></h5>
                <p>We offer competitive pricing without compromising on quality.</p>
            </div>
        </div>
    </section>

    <!-- Tech Advancements Section -->
    <section class="container my-5">
        <h2 class="section-title text-secondary-custom">Tech Advancements</h2>
        <div class="row text-center">
            <div class="col-md-4 animate-card">
                <i class="fas fa-satellite icon-large text-secondary"></i>
                <h5><strong>Digital Survey</strong></h5>
                <p>We use advanced digital tools for precise site analysis and planning.</p>
            </div>
            <div class="col-md-4 animate-card">
                <i class="fas fa-mountain icon-large text-success"></i>
                <h5><strong>Soil Test</strong></h5>
                <p>Ensuring strong foundations with professional soil testing.</p>
            </div>
            <div class="col-md-4 animate-card">
                <i class="fas fa-cube icon-large text-primary"></i>
                <h5><strong>Cube Test</strong></h5>
                <p>Concrete strength testing for long-lasting durability.</p>
            </div>
            <div class="col-md-4 animate-card">
                <i class="fas fa-microscope icon-large text-danger"></i>
                <h5><strong>NDT Test</strong></h5>
                <p>Non-Destructive Testing ensures safety without damaging structures.</p>
            </div>
        </div>
    </section>
    <!-- Working Style Section -->
    <section class="container my-5">
        <h2 class="section-title text-secondary-custom">Our Working Style</h2>
        <p>
            At Punnayee Construction, we follow a structured framework that includes detailed planning, innovative designs, and efficient project execution. We leverage modern technologies and sustainable practices to meet and exceed client expectations.
        </p>
        <div class="row text-center">
            <div class="col-md-4">
                <i class="fas fa-drafting-compass icon-large text-secondary-custom"></i>
                <h5 class="mt-3"><strong>Innovative Designs</strong></h5>
                <p>We create unique, aesthetic designs tailored to your vision.</p>
            </div>
            <div class="col-md-4">
                <i class="fas fa-tools icon-large text-secondary-custom"></i>
                <h5 class="mt-3"><strong>Skilled Workforce</strong></h5>
                <p>Our team of experts ensures top-notch execution and quality.</p>
            </div>
            <div class="col-md-4">
                <i class="fas fa-seedling icon-large text-secondary-custom"></i>
                <h5 class="mt-3"><strong>Sustainable Practices</strong></h5>
                <p>We use eco-friendly materials and methods to minimize impact.</p>
            </div>
        </div>
    </section>

    <!-- Materials Section -->
    <section class="container my-5">
        <h2 class="section-title text-secondary-custom">Materials We Use</h2>
        <p>
            We use premium-grade materials that ensure durability and long-lasting structures. Our materials are sourced from trusted suppliers, ensuring safety, quality, and sustainability in every project.
        </p>
    </section>

    <!-- CEO Section -->
    <section class="container my-5">
        <h2 class="section-title text-secondary-custom">Meet Our CEO</h2>
        <div class="row align-items-center">
            <div class="col-md-4 text-center">
                <img src="/Images/ceo.jpg" alt="Kishor B. Padul" class="ceo-image">
            </div>
            <div class="col-md-8">
                <h3><strong>Kishor B. Padul Patil</strong></h3>
                <p>
                    As the visionary leader of Punnayee Construction, Kishor B. Padul has been instrumental in driving the company's growth and success. With a passion for excellence and years of experience in the industry, he ensures that every project reflects our core values of quality, trust, and innovation.
                </p>
                <p><i class="fas fa-phone"></i> Contact: +91 9764609727</p>
                <div class="social-icons">
                    <a href="https://www.instagram.com/kishor_padul/"><i class="fab fa-instagram"></i></a>
                    <a href="https://in.linkedin.com/in/kishor-padul-a6b0b3152"><i class="fab fa-linkedin"></i></a>
                </div>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

<style>
    .image-container {
    text-align: center;
    margin-bottom: 20px;
    perspective: 1000px;
}

.hover-effect {
    width: 100%;
    height: auto;
    border-radius: 10px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.hover-effect:hover {
    transform: scale(1.05) rotateY(5deg) rotateX(5deg);
    box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.3);
}

.image-caption {
    font-size: 14px;
    color: #555;
    margin-top: 5px;
}

.ceo-image {
    width: 100%;
    max-width: 250px;
    border-radius: 50%;
    transition: transform 0.3s ease-in-out;
}

.ceo-image:hover {
    transform: scale(1.1);
}

.section-title {
    text-align: center;
    font-weight: bold;
    margin-bottom: 20px;
}
.animate-card {
        padding: 20px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .animate-card:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    }

    .icon-large {
        font-size: 40px;
        margin-bottom: 10px;
    }

    .section-title {
        text-align: center;
        font-weight: bold;
        margin-bottom: 20px;
    }

</style>