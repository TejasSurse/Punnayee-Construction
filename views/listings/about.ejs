<% layout('/layouts/boilerplate') -%>
<body>
    <!-- Main Content Wrapper with Padding -->
    <div class="main-content px-3 px-md-4">
        <!-- Header Section -->
        <header class="bg-primary-custom text-center py-5" data-aos="fade-down" data-aos-duration="1000">
            <h1 class="display-4 fw-bold text-white">Punnayee Construction</h1>
            <p class="lead text-light">Your Trusted Partner in Construction Excellence</p>
        </header>

        <!-- About Section -->
        <section class="container my-5" data-aos="fade-up" data-aos-duration="1000">
            <h2 class="section-title text-secondary-custom">About Us</h2>
            <p class="text-muted">
                Punnayee Construction is a premier construction firm dedicated to delivering unparalleled quality and innovative solutions. With extensive experience, we excel in residential, commercial, and industrial projects, ensuring client satisfaction at every stage.
            </p>
        </section>

        <!-- Image Gallery Section -->
        <section class="container my-5" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
            <h2 class="section-title text-secondary-custom">Our Work in Action</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="image-container">
                        <img src="/Images/cons.jpg" alt="Construction Site" class="hover-effect img-fluid">
                        <p class="image-caption text-muted">Latest construction site in progress.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="image-container">
                        <img src="/Images/slope slap.jpg" alt="Slope Slab Construction" class="hover-effect img-fluid">
                        <p class="image-caption text-muted">Precision-engineered slope slab.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Why Choose Us Section -->
        <section class="container my-5" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="400">
            <h2 class="section-title text-secondary-custom">Why Choose Us?</h2>
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-check-circle icon-large text-success"></i>
                        <h5 class="fw-bold">Quality Checks</h5>
                        <p class="text-muted">Rigorous quality control for superior construction.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-cubes icon-large text-primary"></i>
                        <h5 class="fw-bold">Branded Material</h5>
                        <p class="text-muted">Premium materials from trusted brands.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-user-tie icon-large text-warning"></i>
                        <h5 class="fw-bold">No Third Party</h5>
                        <p class="text-muted">In-house management for reliability.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-hard-hat icon-large text-danger"></i>
                        <h5 class="fw-bold">Dedicated Engineer</h5>
                        <p class="text-muted">Assigned engineer for seamless execution.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-tags icon-large text-info"></i>
                        <h5 class="fw-bold">Best Price</h5>
                        <p class="text-muted">Competitive pricing with uncompromised quality.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Tech Advancements Section -->
        <section class="container my-5" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="600">
            <h2 class="section-title text-secondary-custom">Tech Advancements</h2>
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-satellite icon-large text-secondary"></i>
                        <h5 class="fw-bold">Digital Survey</h5>
                        <p class="text-muted">Advanced tools for precise site analysis.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-mountain icon-large text-success"></i>
                        <h5 class="fw-bold">Soil Test</h5>
                        <p class="text-muted">Professional testing for strong foundations.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-cube icon-large text-primary"></i>
                        <h5 class="fw-bold">Cube Test</h5>
                        <p class="text-muted">Concrete strength testing for durability.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-microscope icon-large text-danger"></i>
                        <h5 class="fw-bold">NDT Test</h5>
                        <p class="text-muted">Non-Destructive Testing for safety.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Working Style Section -->
        <section class="container my-5" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="800">
            <h2 class="section-title text-secondary-custom">Our Working Style</h2>
            <p class="text-muted">
                We follow a structured approach with meticulous planning, innovative designs, and efficient execution, leveraging modern technologies and sustainable practices to exceed client expectations.
            </p>
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-drafting-compass icon-large text-secondary-custom"></i>
                        <h5 class="fw-bold mt-3">Innovative Designs</h5>
                        <p class="text-muted">Unique designs tailored to your vision.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-tools icon-large text-secondary-custom"></i>
                        <h5 class="fw-bold mt-3">Skilled Workforce</h5>
                        <p class="text-muted">Expert team for top-notch execution.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="animate-card p-4">
                        <i class="fas fa-seedling icon-large text-secondary-custom"></i>
                        <h5 class="fw-bold mt-3">Sustainable Practices</h5>
                        <p class="text-muted">Eco-friendly materials and methods.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Materials Section -->
        <section class="container my-5" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="1000">
            <h2 class="section-title text-secondary-custom">Materials We Use</h2>
            <p class="text-muted">
                We source premium-grade materials from trusted suppliers, ensuring durability, safety, and sustainability in every project.
            </p>
        </section>

        <!-- CEO Section -->
        <section class="container my-5" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="1200">
            <h2 class="section-title text-secondary-custom">Meet Our CEO</h2>
            <div class="row g-4 align-items-center">
                <div class="col-md-4 text-center">
                    <img src="/Images/ceo.jpg" alt="Kishor B. Padul" class="ceo-image img-fluid">
                </div>
                <div class="col-md-8">
                    <h3 class="fw-bold">Kishor B. Padul Patil</h3>
                    <p class="text-muted">
                        As the visionary leader of Punnayee Construction, Kishor B. Padul drives growth and success with a passion for excellence and extensive industry experience, ensuring every project embodies quality, trust, and innovation.
                    </p>
                    <p class="text-muted"><i class="fas fa-phone me-2"></i>Contact: +91 9764609727</p>
                    <div class="social-icons">
                        <a href="https://www.instagram.com/kishor_padul/" class="text-decoration-none me-3"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="https://in.linkedin.com/in/kishor-padul-a6b0b3152" class="text-decoration-none"><i class="fab fa-linkedin fa-lg"></i></a>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AOS JS -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        // Initialize AOS
        AOS.init({
            once: true, // Animations trigger only once
            offset: 100, // Trigger animations 100px before element enters viewport
        });
    </script>
</body>

<style>
    /* Main Content Padding */
    .main-content {
        padding-left: 1rem;
        padding-right: 1rem;
    }

    @media (min-width: 768px) {
        .main-content {
            padding-left: 2rem;
            padding-right: 2rem;
        }
    }

    /* Header Styling */
    .bg-primary-custom {
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        color: #fff;
    }

    /* Section Title */
    .section-title {
        text-align: center;
        font-weight: 700;
        margin-bottom: 2rem;
        color: #1e3a8a;
    }

    /* Image Container */
    .image-container {
        text-align: center;
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .hover-effect {
        width: 100%;
        height: auto;
        border-radius: 8px;
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    .hover-effect:hover {
        transform: scale(1.08);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .image-caption {
        font-size: 0.9rem;
        color: #6b7280;
        margin-top: 0.5rem;
    }

    /* CEO Image */
    .ceo-image {
        width: 100%;
        max-width: 300px;
        height: auto;
        border-radius: 8px;
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    .ceo-image:hover {
        transform: scale(1.05);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    /* Animate Card */
    .animate-card {
        padding: 1.5rem;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .animate-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }

    .icon-large {
        font-size: 2.5rem;
        margin-bottom: 0.75rem;
    }

    /* Social Icons */
    .social-icons a {
        color: #1e3a8a;
        transition: color 0.3s ease;
    }

    .social-icons a:hover {
        color: #3b82f6;
    }

    /* Text Colors */
    .text-secondary-custom {
        color: #1e3a8a;
    }
</style>