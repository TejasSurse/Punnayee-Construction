<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==" crossorigin="anonymous" async>

<!-- Consolidated Styles -->
<style>
    @keyframes marquee {
        0% { transform: translateX(100%); }
        100% { transform: translateX(-100%); }
    }
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @keyframes slideInLeft {
        from { opacity: 0; transform: translateX(-30px); }
        to { opacity: 1; transform: translateX(0); }
    }
    @keyframes slideInRight {
        from { opacity: 0; transform: translateX(30px); }
        to { opacity: 1; transform: translateX(0); }
    }
    .service-box, .timeline-item {
        opacity: 0;
        transition: opacity 0.3s ease, transform 0.3s ease;
        will-change: opacity, transform;
    }
    .service-box.visible {
        animation: fadeInUp 0.3s ease forwards;
    }
    .timeline-item:nth-child(odd).visible {
        animation: slideInLeft 0.3s ease forwards;
    }
    .timeline-item:nth-child(even).visible {
        animation: slideInRight 0.3s ease forwards;
    }
    .service-box:hover, .timeline-item:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }
    @media (max-width: 768px) {
        h1[style*="font-size: 5rem"] { font-size: 3rem !important; }
        p[style*="font-size: 1.5rem; max-width: 700px"] { font-size: 1.2rem !important; }
        h2[style*="font-size: 3.5rem"] { font-size: 2.5rem !important; }
        div[style*="padding: 3rem"] { padding: 2rem !important; }
        .timeline-item { flex-direction: column !important; text-align: center !important; }
        div[style*="padding-right: 2rem"], div[style*="padding-left: 2rem"] { padding: 0 !important; }
        .timeline-item:nth-child(even) { justify-content: center !important; }
        .timeline-item:nth-child(even) > div { flex-direction: column; }
        .timeline-item:nth-child(even) i { margin-left: 0 !important; margin-top: 0.5rem; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; overflow-x: hidden; }
</style>

