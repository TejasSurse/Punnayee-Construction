<% layout('/layouts/boilerplate') -%>
<body>
    <!-- Hero Section -->
    <div class="hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1 class="hero-title">Transforming Your Dreams Into Reality</h1>
            <p class="hero-subtitle">With over a decade of experience, Punnayee Construction leads the way in delivering exceptional construction services tailored to your vision.</p>
            <a href="/contacts" class="cta-button">Get in Touch</a>
        </div>
    </div>

    <!-- Services Section -->
    <section class="services-section">
        <h2 class="services-title">Our Expertise</h2>
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4 mb-4">
                    <div class="service-box">
                        <i class="fas fa-building"></i>
                        <h5 class="mt-3">Commercial Projects</h5>
                        <p>We deliver state-of-the-art commercial spaces designed for success.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="service-box">
                        <i class="fas fa-home"></i>
                        <h5 class="mt-3">Residential Projects</h5>
                        <p>Building homes that blend comfort with modernity.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="service-box">
                        <i class="fas fa-warehouse"></i>
                        <h5 class="mt-3">Industrial Projects</h5>
                        <p>Efficient and innovative solutions for industrial needs.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- How We Work Section -->
    <section class="how-we-work-section">
        <h2 class="section-title">How We Work!</h2>
        <div class="divider"></div>
        <p class="section-subtitle"><strong>Our Methodology: Innovating with Technology, Perfecting with Craftsmanship</strong></p>
        <div class="roadmap-container">
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-lightbulb"></i></span>
                <h5>1. Understanding Client Requirements</h5>
                <p>We begin by comprehending your needs and expectations to lay a strong foundation.</p>
            </div>
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-calculator"></i></span>
                <h5>2. Detailed Cost Estimation</h5>
                <p>Transparent and precise cost planning ensures no surprises down the road.</p>
            </div>
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-drafting-compass"></i></span>
                <h5>3. Architectural Planning</h5>
                <p>Crafting designs that blend innovation with practicality.</p>
            </div>
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-calendar-alt"></i></span>
                <h5>4. Project Scheduling</h5>
                <p>Strategic planning to ensure timely execution.</p>
            </div>
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-tools"></i></span>
                <h5>5. Site Execution Start</h5>
                <p>Executing with precision and adherence to quality standards.</p>
            </div>
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-handshake"></i></span>
                <h5>6. Professional Project Handover</h5>
                <p>Delivering your dream project with complete satisfaction.</p>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
