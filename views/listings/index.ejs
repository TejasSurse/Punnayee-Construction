<% layout('/layouts/boilerplate') -%>
<body>
    <!-- Hero Section -->
    <div class="hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1 class="hero-title"><strong>Transforming Your Dreams Into Reality</strong></h1>
            <p class="hero-subtitle">With over a decade of experience, <strong>Punnayee Construction</strong> leads the way in delivering exceptional construction services tailored to your vision.</p>
            <a href="/contacts" class="cta-button"><strong>Get in Touch</strong></a>
        </div>
    </div>

    <!-- Services Section -->
    <section class="services-section">
        <h2 class="services-title"><strong>Our Expertise</strong></h2>
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4 mb-4">
                    <div class="service-box">
                        <i class="fas fa-building"></i>
                        <h5 class="mt-3"><strong>Commercial Projects</strong></h5>
                        <p>We deliver <strong>state-of-the-art commercial spaces</strong> designed for success.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="service-box">
                        <i class="fas fa-home"></i>
                        <h5 class="mt-3"><strong>Residential Projects</strong></h5>
                        <p>Building <strong>homes</strong> that blend comfort with modernity.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="service-box">
                        <i class="fas fa-warehouse"></i>
                        <h5 class="mt-3"><strong>Industrial Projects</strong></h5>
                        <p>Providing <strong>efficient and innovative solutions</strong> for industrial needs.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- How We Work Section -->
    <section class="how-we-work-section">
        <h2 class="section-title"><strong>How We Work!</strong></h2>
        <div class="divider"></div>
        <p class="section-subtitle">Our Methodology: <strong>Innovating with Technology</strong>, Perfecting with Craftsmanship.</p>
        <div class="roadmap-container">
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-lightbulb"></i></span>
                <h5><strong>1. Understanding Client Requirements</strong></h5>
                <p>We begin by <strong>comprehending your needs and expectations</strong> to lay a strong foundation.</p>
            </div>
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-calculator"></i></span>
                <h5><strong>2. Detailed Cost Estimation</strong></h5>
                <p>Transparent and precise <strong>cost planning</strong> ensures no surprises down the road.</p>
            </div>
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-drafting-compass"></i></span>
                <h5><strong>3. Architectural Planning</strong></h5>
                <p>Crafting <strong>designs</strong> that blend innovation with practicality.</p>
            </div>
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-calendar-alt"></i></span>
                <h5><strong>4. Project Scheduling</strong></h5>
                <p>Strategic <strong>planning</strong> to ensure timely execution.</p>
            </div>
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-tools"></i></span>
                <h5><strong>5. Site Execution Start</strong></h5>
                <p>Executing with precision and adherence to <strong>quality standards</strong>.</p>
            </div>
            <div class="roadmap-item">
                <span class="roadmap-icon"><i class="fas fa-handshake"></i></span>
                <h5><strong>6. Professional Project Handover</strong></h5>
                <p>Delivering your <strong>dream project</strong> with complete satisfaction.</p>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
