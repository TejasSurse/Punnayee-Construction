<% layout('/layouts/boilerplate') -%>

<!-- Marquee Section -->
<div class="marquee">
    <div class="marquee-content">
        📞 Contact Us: +91 97646 09727 | 📧 Email: punnayeeconstruction@gmail.com | 📍 Location: Punnyaee Developers, A3/1, N-7, Cidco, Aurangabad, Maharashtra, 431001
    </div>
</div>

<!-- Projects Section -->
<section class="projects-section container py-5">
    <h2 class="section-title" data-aos="fade-down" data-aos-duration="1000">Our Projects</h2>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 justify-content-center">
        <% for (let project of projects) { %>
            <div class="col d-flex justify-content-center">
                <div class="project-card" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
                    <div class="image-container">
                        <img 
                            class="card-img-top" 
                            src="data:image/jpeg;base64,<%= Buffer.from(project.image).toString('base64') %>" 
                            alt="Project Image">
                        <div class="project-overlay">
                            <div class="project-details">
                                <h5 class="project-title"><%= project.title %></h5>
                                <p><i class="fas fa-map-marker-alt me-2"></i><%= project.location %></p>
                                <p><i class="fas fa-rupee-sign me-2"></i><%= project.cost.toLocaleString("en-IN") %></p>
                                <p><i class="fas fa-ruler-combined me-2"></i><%= project.size %> sq. ft</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</section>

<!-- Bootstrap and AOS JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
<script>
    AOS.init({
        once: true,
        offset: 100,
        duration: 1000
    });
</script>

<style>
    :root {
        --primary: #1a3c34; /* Deep teal */
        --secondary: #f4a261; /* Warm orange */
        --accent: #e76f51; /* Coral */
        --light: #f8f9fa; /* Off-white */
        --dark: #264653; /* Dark teal */
        --overlay-bg: rgba(26, 60, 52, 0.85); /* Dimmed overlay */
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--light);
        overflow-x: hidden;
    }

    .projects-section {
        padding: 5rem 0;
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 700;
        text-align: center;
        color: var(--primary);
        margin-bottom: 3rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .project-card {
        background: var(--light);
        border-radius: 15px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        max-width: 400px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .project-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
    }

    .image-container {
        position: relative;
        max-height: 300px;
        overflow: hidden;
    }

    .card-img-top {
        object-fit: cover;
        width: 100%;
        height: 300px;
        transition: transform 0.5s ease, filter 0.5s ease;
    }

    .project-card:hover .card-img-top {
        transform: scale(1.1);
        filter: brightness(0.6);
    }

    .project-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--overlay-bg);
        opacity: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.4s ease;
    }

    .project-card:hover .project-overlay {
        opacity: 1;
    }

    .project-details {
        color: var(--light);
        text-align: center;
        padding: 1.5rem;
        transform: translateY(20px);
        opacity: 0;
        transition: transform 0.4s ease, opacity 0.4s ease;
    }

    .project-card:hover .project-details {
        transform: translateY(0);
        opacity: 1;
    }

    .project-title {
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--secondary);
    }

    .project-details p {
        font-size: 0.9rem;
        margin: 0.5rem 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .project-details i {
        font-size: 1rem;
        color: var(--accent);
    }

    .marquee {
        background: var(--dark);
        color: var(--light);
        padding: 1rem 0;
        overflow: hidden;
        white-space: nowrap;
        font-size: 0.9rem;
    }

    .marquee-content {
        display: inline-block;
        animation: marquee 20s linear infinite;
    }

    @keyframes marquee {
        0% { transform: translateX(100%); }
        100% { transform: translateX(-100%); }
    }

    @media (max-width: 768px) {
        .section-title {
            font-size: 2rem;
        }

        .project-card {
            max-width: 100%;
        }

        .image-container {
            max-height: 250px;
        }

        .card-img-top {
            height: 250px;
        }

        .project-title {
            font-size: 1.2rem;
        }

        .project-details p {
            font-size: 0.85rem;
        }
    }
</style>