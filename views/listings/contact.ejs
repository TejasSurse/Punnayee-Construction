<% layout('/layouts/boilerplate') -%>

<div class="container my-5 mb-2">
  <div class="row justify-content-center">
    <!-- Contact Form Section -->
    <div class="col-md-6">
      <div class="card shadow-sm h-100 w-100">
        <div class="card-body">
          <h4 class="card-title text-center mb-4"><strong>Contact Us</strong></h4>
          <form action="/contact" method="POST">
            <div class="mb-3">
              <label for="name" class="form-label"><strong>Name</strong></label>
              <input type="text" class="form-control" id="name" name="name" placeholder="Enter your name">
            </div>
            <div class="mb-3">
              <label for="phone" class="form-label"><strong>Phone Number</strong></label>
              <input type="tel" class="form-control" id="phone" name="phone" placeholder="Enter your phone number">
            </div>
            <div class="mb-3">
              <label for="email" class="form-label"><strong>Email</strong></label>
              <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email">
            </div>
            <div class="mb-3">
              <label for="subject" class="form-label"><strong>Subject</strong></label>
              <input type="text" class="form-control" id="subject" name="subject" placeholder="Enter subject">
            </div>
            <div class="mb-3">
              <label for="message" class="form-label"><strong>Message</strong></label>
              <textarea class="form-control" id="message" name="message" rows="4" placeholder="Enter your message"></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-100"><strong>Submit</strong></button>
          </form>
        </div>
      </div>
    </div>

    <!-- Company Information Section -->
    <div class="col-md-6 mb-2 mt-2">
      <div class="card shadow-sm h-100 w-100">
        <div class="card-body text-center">
          <h4 class="card-title mb-4"><strong>Our Information</strong></h4>
          <p>
            <strong>Location:</strong><br>
            Punnyaee Developers, A3/1, N-7, Cidco, Cidco, N- 7 Police Station Road, Aurangabad, Aurangabad, Maharashtra, 431001<br>
            Punnyaee Construction, Flat 15, Mahalaxmi Alankar 2, Mustafabad, A, Disa Nagri Road, Aurangabad, Aurangabad, Maharashtra, 431001
          </p>
          <p>
            <strong>Email:</strong><br>
            <a href="mailto:punnayeeconstruction@gmail.com" class="text-dark">
              <i class="fas fa-envelope me-2"></i>punnayeeconstruction@gmail.com
            </a>
          </p>
          <p>
            <strong>Phone:</strong><br>
            <a href="tel:+919764609727" class="text-dark">
              <i class="fas fa-phone-alt me-2"></i>+91 97646 09727
            </a>
          </p>
          <div class="d-flex justify-content-center mt-4">
            <h4><strong>Follow Us On:</strong></h4>
            <!-- Social Media Icons -->
            <a href="https://www.instagram.com/punnyaee_construction_/" target="_blank" class="text-danger me-3">
              <i class="fab fa-instagram fa-2x"></i>
            </a>
            <a href="https://wa.me/+919764609727" target="_blank" class="text-success me-3">
              <i class="fab fa-whatsapp fa-2x"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Embedded Map Section -->
  <div class="row mt-5">
    <div class="col-12">
      <h4 class="text-center mb-4"><strong>Find Us Here</strong></h4>
      <div class="d-flex justify-content-center">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d120073.18649111116!2d75.30520145!3d19.870096249999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bdb9815a369bc63%3A0x712d538b29a2a73e!2sChhatrapati%20Sambhaji%20Nagar%2C%20Maharashtra!5e0!3m2!1sen!2sin!4v1736479367489!5m2!1sen!2sin" 
          width="100%" 
          height="450" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </div>
</div>
