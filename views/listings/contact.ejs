<% layout('/layouts/boilerplate') -%>
<body>
    <div class="main-content px-3 px-md-4">
        <section class="contact-section container mx-auto py-5">
            <h2 class="section-title" data-aos="fade-down" data-aos-duration="1000">Contact Us</h2>
            <div class="row g-4 mb-5">
                <!-- Contact Form -->
                <div class="col-lg-6">
                    <div class="contact-card" data-aos="fade-right" data-aos-duration="1000" data-aos-delay="200">
                        <form action="/contact" method="POST" class="contact-form">
                            <div class="form-group">
                                <label for="name">Name</label>
                                <input type="text" id="name" name="name" placeholder="Your Name" required>
                            </div>
                            <div class="form-group">
                                <label for="phone">Phone Number</label>
                                <input type="tel" id="phone" name="phone" placeholder="Your Phone Number" required>
                            </div>
                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="email" id="email" name="email" placeholder="Your Email" required>
                            </div>
                            <div class="form-group">
                                <label for="subject">Subject</label>
                                <input type="text" id="subject" name="subject" placeholder="Subject" required>
                            </div>
                            <div class="form-group">
                                <label for="message">Message</label>
                                <textarea id="message" name="message" rows="4" placeholder="Your Message" required></textarea>
                            </div>
                            <button type="submit" class="submit-btn">Send Message</button>
                        </form>
                    </div>
                </div>

                <!-- Embedded Map -->
                <div class="col-lg-6">
                    <div class="map-container" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="400">
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d120073.18649111116!2d75.30520145!3d19.870096249999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bdb9815a369bc63%3A0x712d538b29a2a73e!2sChhatrapati%20Sambhaji%20Nagar%2C%20Maharashtra!5e0!3m2!1sen!2sin!4v1736479367489!5m2!1sen!2sin" 
                            width="100%" 
                            height="100%" 
                            style="border: 0;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>

            <!-- Company Information -->
            <div class="info-container" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="600">
                <div class="info-card">
                    <h3 class="info-title">Get in Touch</h3>
                    <div class="info-content">
                        <div class="info-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <div>
                                <h5>Location</h5>
                                <p>Punnyaee Developers, A3/1, N-7, Cidco, N-7 Police Station Road, Aurangabad, Maharashtra, 431001</p>
                                <p>Punnyaee Construction, Flat 15, Mahalaxmi Alankar 2, Mustafabad, Disa Nagri Road, Aurangabad, Maharashtra, 431001</p>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-envelope"></i>
                            <div>
                                <h5>Email</h5>
                                <a href="mailto:punnayeeconstruction@gmail.com">punnayeeconstruction@gmail.com</a>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-phone-alt"></i>
                            <div>
                                <h5>Phone</h5>
                                <a href="tel:+919764609727">+91 97646 09727</a>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="fab fa-instagram"></i>
                            <div>
                                <h5>Follow Us</h5>
                                <div class="social-links">
                                    <a href="https://www.instagram.com/punnyaee_construction_/" target="_blank"><i class="fab fa-instagram"></i></a>
                                    <a href="https://wa.me/+919764609727" target="_blank"><i class="fab fa-whatsapp"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AOS JS -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init({
            once: true,
            offset: 100,
            duration: 1000
        });
    </script>
</body>

<style>
    :root {
        --black: #000000;
        --white: #FFFFFF;
        --gray-dark: #1F1F1F;
        --gray-medium: #333333;
        --gray-light: #4B4B4B;
        --gray-lighter: #666666;
        --gray-lightest: #999999;
        --gray-border: #CCCCCC;
        --gray-bg: #E5E5E5;
        --gray-bg-light: #F5F5F5;
        --primary: #1e3a8a;
        --primary-light: #3b82f6;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--white);
        overflow-x: hidden;
    }

    .main-content {
        padding-left: 1rem;
        padding-right: 1rem;
    }

    @media (min-width: 768px) {
        .main-content {
            padding-left: 2rem;
            padding-right: 2rem;
        }
    }

    .contact-section {
        padding: 5rem 0;
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 700;
        text-align: center;
        color: var(--primary);
        margin-bottom: 3rem;
    }

    /* Contact Card and Map */
    .contact-card, .map-container {
        background: var(--white);
        border-radius: 15px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        height: 100%;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .contact-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
    }

    .map-container {
        overflow: hidden;
    }

    .map-container iframe {
        border-radius: 15px;
    }

    /* Form Styling */
    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding: 2rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-group label {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--gray-medium);
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--gray-border);
        border-radius: 8px;
        font-size: 0.9rem;
        transition: border-color 0.3s, box-shadow 0.3s;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
    }

    .form-group textarea {
        resize: vertical;
        min-height: 100px;
    }

    .submit-btn {
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        color: var(--white);
        padding: 0.75rem;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.9rem;
        cursor: pointer;
        transition: background 0.3s, transform 0.3s;
    }

    .submit-btn:hover {
        background: linear-gradient(135deg, var(--primary-light), var(--primary));
        transform: translateY(-2px);
    }

    /* Info Card */
    .info-container {
        margin-top: 3rem;
    }

    .info-card {
        background: linear-gradient(to bottom right, var(--gray-bg-light), var(--gray-bg));
        border-radius: 15px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        padding: 2rem;
    }

    .info-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--primary);
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .info-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .info-item i {
        font-size: 1.5rem;
        color: var(--primary);
    }

    .info-item h5 {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--gray-medium);
        margin-bottom: 0.5rem;
    }

    .info-item p, .info-item a {
        font-size: 0.9rem;
        color: var(--gray-lighter);
        margin: 0;
        text-decoration: none;
        transition: color 0.3s;
    }

    .info-item a:hover {
        color: var(--primary-light);
    }

    .social-links {
        display: flex;
        gap: 1rem;
    }

    .social-links a {
        color: var(--gray-medium);
        font-size: 1.25rem;
        transition: color 0.3s;
    }

    .social-links a:hover {
        color: var(--primary-light);
    }

    /* Responsive Design */
    @media (max-width: 992px) {
        .section-title {
            font-size: 2rem;
        }

        .contact-card, .map-container {
            height: auto;
            min-height: 400px;
        }

        .info-content {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 576px) {
        .contact-form {
            padding: 1.5rem;
        }

        .info-card {
            padding: 1.5rem;
        }
    }
</style>