<% layout('/layouts/boilerplate') -%>
<style>
  .card-text {
    margin-bottom: 0;
  }

  .card-link {
    display: inline-block;
    margin-right: 10px;
  }
</style>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-1 g-4 mt-2">
  <% for (let project of projects) { %>
    <div class="card col text-center shadow-sm">
      <div class="image-container">
        <img
          class="card-img-top img-fluid"
          src="data:image/jpeg;base64,<%= Buffer.from(project.image).toString('base64') %>"
          alt="Project Image"
        />
      </div>
      <div class="card-body">
        <p class="card-text">
          <b>Title:</b> <%= project.title %><br>
          <b>Location:</b> <%= project.location %><br>
          <b>Cost:</b> &#8377 <%= project.cost.toLocaleString("en-In") %><br>
          <b>Size:</b> <%= project.size %> sq. meters
        </p>
        <a href="/edit/<%= project.id %>" class="text-dark me-2">
          <i class="fas fa-edit"></i>
        </a>
        <a href="/delete/<%= project.id %>" class="text-dark">
          <i class="fas fa-trash-alt"></i>
        </a>
        
        
          
      </div>
    </div>
  <% } %>
</div>