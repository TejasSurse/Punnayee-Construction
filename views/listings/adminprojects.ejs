<% layout('/layouts/boilerplate') -%>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-1 g-4 mt-2">
  <% for (let project of projects) { %>
    <div class="card col text-center shadow-sm" style="padding: 15px; border-radius: 10px; overflow: hidden; min-height: 350px; display: flex; flex-direction: column; justify-content: space-between;">
      <div class="image-container" style="margin-bottom: 15px;">
        <img
          class="card-img-top img-fluid"
          style="border-radius: 10px; max-height: 200px; object-fit: cover;"
          src="data:image/jpeg;base64,<%= Buffer.from(project.image).toString('base64') %>"
          alt="Project Image"
        />
      </div>
      <div class="card-body" style="text-align: center;">
        <p class="card-text" style="margin-bottom: 15px; font-size: 14px;">
          <b>Title:</b> <%= project.title %><br>
          <b>Location:</b> <%= project.location %><br>
          <b>Cost:</b> &#8377 <%= project.cost.toLocaleString("en-In") %><br>
          <b>Size:</b> <%= project.size %> sq. ft
        </p>
        <div style="display: flex; justify-content: center; align-items: center; gap: 15px;">
          <a href="/edit/<%= project.id %>" style="text-decoration: none; color: #000; font-size: 18px;">
            <i class="fas fa-edit"></i>
          </a>
          <a href="/delete/<%= project.id %>" style="text-decoration: none; color: #000; font-size: 18px;">
            <i class="fas fa-trash-alt"></i>
          </a>
        </div>
      </div>
    </div>
  <% } %>
</div>
