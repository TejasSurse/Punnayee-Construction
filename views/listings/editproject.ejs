<!-- Main Content Wrapper with Side Margins -->
<div class="main-content px-3 px-md-4 py-5">
    <section class="edit-project-section container">
        <h2 class="section-title" data-aos="fade-down" data-aos-duration="1000">Edit Project</h2>
        <form action="/update/<%= project.id %>" method="POST" enctype="multipart/form-data" class="edit-form" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
            <!-- Title Field -->
            <div class="form-group">
                <label for="title">Title</label>
                <input 
                    type="text" 
                    id="title" 
                    name="title" 
                    value="<%= project.title %>" 
                    placeholder="Enter project title" 
                    required>
            </div>

            <!-- Location Field -->
            <div class="form-group">
                <label for="location">Location</label>
                <input 
                    type="text" 
                    id="location" 
                    name="location" 
                    value="<%= project.location %>" 
                    placeholder="Enter project location" 
                    required>
            </div>

            <!-- Cost Field -->
            <div class="form-group">
                <label for="cost">Cost (₹)</label>
                <input 
                    type="text" 
                    id="cost" 
                    name="cost" 
                    value="<%= project.cost %>" 
                    placeholder="Enter project cost" 
                    required>
            </div>

            <!-- Size Field -->
            <div class="form-group">
                <label for="size">Size (sq. meters)</label>
                <input 
                    type="number" 
                    id="size" 
                    name="size" 
                    value="<%= project.size %>" 
                    placeholder="Enter project size" 
                    required>
            </div>

            <!-- Image Field -->
            <div class="form-group">
                <label for="image">Project Image</label>
                <input 
                    type="file" 
                    id="image" 
                    name="image" 
                    accept="image/*">
                <p class="form-text">
                    Current image will remain unchanged if no new file is uploaded.
                </p>
            </div>

            <!-- Buttons -->
            <div class="form-buttons">
                <button type="submit" class="submit-btn">Update Project</button>
                <a href="/admin" class="cancel-btn">Cancel</a>
            </div>
        </form>
    </section>
</div>

<!-- AOS JS -->
<script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
<script>
    AOS.init({
        once: true,
        offset: 100,
        duration: 1000
    });
</script>

