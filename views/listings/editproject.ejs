<% layout('/layouts/boilerplate') -%>
<div class="container mt-5">
    <h2 class="text-center mb-4">Edit Project</h2>
    <form action="/update/<%= project.id %>" method="POST" enctype="multipart/form-data">
        <!-- Title Field -->
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input 
                type="text" 
                class="form-control" 
                id="title" 
                name="title" 
                value="<%= project.title %>" 
                placeholder="Enter project title" 
                required>
        </div>
        
        <!-- Description Field -->
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea 
                class="form-control" 
                id="description" 
                name="description" 
                rows="4" 
                placeholder="Enter project description" 
                required><%= project.description %></textarea>
        </div>

        <!-- Location Field -->
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input 
                type="text" 
                class="form-control" 
                id="location" 
                name="location" 
                value="<%= project.location %>" 
                placeholder="Enter project location" 
                required>
        </div>

        <!-- Cost Field -->
        <div class="mb-3">
            <label for="cost" class="form-label">Cost (₹)</label>
            <input 
                type="number" 
                class="form-control" 
                id="cost" 
                name="cost" 
                value="<%= project.cost %>" 
                placeholder="Enter project cost" 
                required>
        </div>

        <!-- Size Field -->
        <div class="mb-3">
            <label for="size" class="form-label">Size (sq. meters)</label>
            <input 
                type="number" 
                class="form-control" 
                id="size" 
                name="size" 
                value="<%= project.size %>" 
                placeholder="Enter project size" 
                required>
        </div>

        <!-- Image Field -->
        <div class="mb-3">
            <label for="image" class="form-label">Project Image</label>
            <input 
                type="file" 
                class="form-control" 
                id="image" 
                name="image" 
                accept="image/*">
            <p class="form-text mt-1">
                Current image will remain unchanged if no new file is uploaded.
            </p>
        </div>

        <!-- Buttons -->
        <div class="text-center">
            <button type="submit" class="btn btn-success">Update Project</button>
            <a href="/admin" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
